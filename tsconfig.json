{
    "compilerOptions": {
        "lib": [
            "ESNext",
            "dom"
        ],
        "module": "ESNext",
        "target": "ESNext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "sourceMap": true,
        "outDir": "dist",
        "baseUrl": "./src",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "strict": true,
        "types": [
            "bun-types"
        ]
    },
    "exclude": [
        "dist",
        "node_modules"
    ],
    "include": [
        "src"
    ]
}